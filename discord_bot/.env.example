# Discord bot credentials — get from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# The single Discord server (guild) the bot operates on. Slash commands are
# registered only on this guild for instant updates (no global propagation
# delay).
SPECA_DISCORD_GUILD_ID=000000000000000000

# Where to find the speca repository (provides scripts/run_phase.py and the
# speca CLI). Default: the parent directory of this bot directory.
SPECA_REPO_PATH=..

# Archive root that the bot reads / writes for corpus operations. Default:
# <SPECA_REPO_PATH>/.speca/runs
# SPECA_ARCHIVE_ROOT=

# Which Discord category to use as the "SPECA root" parent. New per-run
# categories are siblings of it; the control-panel channel lives inside.
# Optional — if omitted, the bot creates one called "SPECA" on first launch.
# SPECA_DISCORD_PARENT_CATEGORY=SPECA

# Claude credentials for the /ask chat cog. Either an Anthropic API key or
# the path to a speca-cli auth.json (paste-code OAuth result). One of:
# ANTHROPIC_API_KEY=sk-ant-api03-...
# SPECA_AUTH_JSON_PATH=~/.config/speca/auth.json

# Optional knobs
# SPECA_DISCORD_LOG_LEVEL=INFO
# SPECA_DISCORD_MAX_LIVE_LOG_LINES=30
